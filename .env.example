# Configuration du serveur
PORT=3000

# Clé secrète Shopify pour vérifier les webhooks (HMAC)
# Vous la trouverez dans votre boutique Shopify Admin > Settings > Notifications > Webhooks
SHOPIFY_WEBHOOK_SECRET=your_shopify_webhook_secret_here

# Référence client fixe pour Sage X3
SAGE_CLIENT_REFERENCE=0147907400

# Répertoire où sauvegarder les fichiers de commande
OUTPUT_DIRECTORY=./orders

# ===== CONFIGURATION FTP =====
# Laissez vide pour désactiver l'upload FTP automatique
# Les 3 paramètres suivants sont OBLIGATOIRES pour activer FTP

# Hôte du serveur FTP
FTP_HOST=ftp.votre-serveur.com

# Utilisateur FTP
FTP_USER=votre_utilisateur

# Mot de passe FTP
FTP_PASSWORD=votre_mot_de_passe

# Port FTP (optionnel, défaut: 21)
FTP_PORT=21

# Utiliser FTPS (FTP sécurisé) (optionnel, défaut: false)
FTP_SECURE=false

# Répertoire distant sur le serveur FTP (optionnel)
# Exemple: /sage-x3/import ou /commandes
FTP_REMOTE_DIR=/sage-x3/import

# Préfixe à ajouter aux noms de fichiers uploadés (optionnel)
# Exemple: SHOPIFY_ donnera SHOPIFY_order_1001_20251218_160110.txt
FTP_FILE_PREFIX=

# Supprimer le fichier local après upload réussi (optionnel, défaut: false)
# ATTENTION: activer uniquement si le serveur FTP est fiable
FTP_DELETE_AFTER_UPLOAD=false

# Activer le mode debug FTP pour voir les logs détaillés (optionnel, défaut: false)
FTP_DEBUG=false
