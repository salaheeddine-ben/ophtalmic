# Configuration du serveur
PORT=3000

# Clé secrète Shopify pour vérifier les webhooks (HMAC)
# Vous la trouverez dans votre boutique Shopify Admin > Settings > Notifications > Webhooks
SHOPIFY_WEBHOOK_SECRET=your_shopify_webhook_secret_here

# Référence client fixe pour Sage X3
SAGE_CLIENT_REFERENCE=0147907400

# Répertoire où sauvegarder les fichiers de commande
OUTPUT_DIRECTORY=./orders
